# Copy to deploy.env and fill in. deploy.env is gitignored.
#
# untofu ships CONTENT ONLY into the edge stack. Routing, nginx and the tunnel
# belong to elusive-edge (CT 136).
#
# The PVE node hosting the container, reachable from this Mac. bb1/bb2 are not
# on the LAN route — use their Tailscale addresses.
PVE_HOST=root@100.81.33.74

# CT 136 `edge` on bb2.
CTID=136

# Our directory inside the edge stack. Never anything above this.
REMOTE_DIR=/opt/edge/sites/untofu

# Checked by content at the end of a deploy.
PUBLIC_URL=https://untofu.elusive.net/
