# Copy to deploy.env and fill in. deploy.env is gitignored.
#
# The PVE node hosting the container, reachable from this Mac. bb1/bb2 are not
# on the LAN route — use their Tailscale addresses.
PVE_HOST=root@100.81.33.74

# Container ID of the fontfetch CT on that node.
CTID=

# Where the compose project lives inside the container.
REMOTE_DIR=/opt/fontfetch

# Checked at the end of a deploy.
PUBLIC_URL=https://fontfetch.elusive.net/
